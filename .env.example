# Docker Compose reads .env at runtime; never commit a populated local .env.
# Keep the internal bind at 10000 so the image health check can reach it.
GUNICORN_CMD_ARGS=--bind=0.0.0.0:10000 --workers=2 --access-logfile=- --error-logfile=- --timeout=30 --graceful-timeout=30 --worker-tmp-dir=/tmp
FIELDWISE_LOG_LEVEL=INFO

# Compose host binding. Set 0.0.0.0 deliberately for remote access behind TLS.
FIELDWISE_BIND_ADDRESS=127.0.0.1
FIELDWISE_HOST_PORT=10000

# Flask local startup and hosted process port; Gunicorn's Docker bind is above.
PORT=10000

# Optional trusted local artifact paths. Mount read-only when overriding in Docker.
# FIELDWISE_DATA_PATH=/app/backend/data/real_final_dataset.csv
# FIELDWISE_MODEL_PATH=/app/backend/models/yield_model.pkl
# FIELDWISE_METRICS_PATH=/app/backend/models/model_metrics.json
